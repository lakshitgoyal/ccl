{
  "functions": {
    "api/router.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "api/process-registration.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "api/process-registration2.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/process-registration.php",
      "dest": "/api/process-registration.php"
    },
    {
      "src": "/process-registration2.php",
      "dest": "/api/process-registration2.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/router.php"
    }
  ]
}